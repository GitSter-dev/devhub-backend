#cloud-config
write_files:
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" },
        "live-restore": true
      }

  - path: /etc/systemd/system/devhub.service
    permissions: "0644"
    content: |
      [Unit]
      Description=DevHub compose stack
      Requires=docker.service data.mount
      After=docker.service data.mount network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/devhub
      Environment=AWS_REGION=${region}
      Environment=PARAM_PATH=${parameter_path}
      ExecStartPre=/opt/devhub/render-env.sh
      ExecStart=/usr/bin/docker compose -f compose.prod.yaml --env-file app.env --env-file image.env up -d --wait --wait-timeout 300
      ExecStop=/usr/bin/docker compose -f compose.prod.yaml --env-file app.env --env-file image.env down

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/devhub-backup.service
    permissions: "0644"
    content: |
      [Unit]
      Description=DevHub nightly logical backup
      Requires=data.mount
      After=devhub.service

      [Service]
      Type=oneshot
      Environment=AWS_REGION=${region}
      WorkingDirectory=/opt/devhub
      ExecStart=/opt/devhub/backup.sh

  - path: /etc/systemd/system/devhub-backup.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Run the DevHub backup nightly at 02:30 UTC

      [Timer]
      OnCalendar=*-*-* 02:30:00 UTC
      Persistent=true

      [Install]
      WantedBy=timers.target

  - path: /etc/systemd/system/devhub-prune.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Reclaim docker disk space

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/docker system prune -af --filter until=168h

  - path: /etc/systemd/system/devhub-prune.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Weekly docker prune

      [Timer]
      OnCalendar=Sun *-*-* 04:00:00 UTC
      Persistent=true

      [Install]
      WantedBy=timers.target

runcmd:
  - dnf -y install docker jq

  # The compose plugin is not packaged for AL2023, so install it directly.
  - mkdir -p /usr/libexec/docker/cli-plugins
  - curl -fsSL "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" -o /usr/libexec/docker/cli-plugins/docker-compose
  - chmod +x /usr/libexec/docker/cli-plugins/docker-compose

  - systemctl enable --now docker

  # Swap is cheap insurance against a transient spike on a 4 GB box.
  - |
    if [ ! -f /swapfile ]; then
      dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi

  # On Nitro instances /dev/sdf is not a real path; the by-id link is stable.
  - |
    DEV="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${replace(volume_id, "-", "")}"
    for i in $(seq 1 30); do [ -e "$DEV" ] && break; sleep 2; done
    if [ ! -e "$DEV" ]; then echo "data volume never appeared" >&2; exit 1; fi

    # Format ONLY if there is no filesystem. An unconditional mkfs here would
    # destroy the database on every instance replacement.
    if ! blkid "$DEV" >/dev/null 2>&1; then
      mkfs.ext4 -L devhub-data "$DEV"
    fi

    mkdir -p /data
    grep -q 'LABEL=devhub-data' /etc/fstab || \
      echo 'LABEL=devhub-data /data ext4 defaults,nofail,x-systemd.device-timeout=30s 0 2' >> /etc/fstab
    systemctl daemon-reload
    mount -a
    findmnt /data || { echo "/data failed to mount" >&2; exit 1; }

  - mkdir -p /data/postgres /data/caddy /data/caddy-config /data/backups
  - mkdir -p /opt/devhub/secrets
  - chmod 0750 /opt/devhub/secrets

  # image.env is a placeholder until the first deploy writes a real tag.
  - touch /opt/devhub/image.env

  - systemctl daemon-reload
  # devhub.service is enabled but NOT started: there is no image tag yet.
  - systemctl enable devhub.service
  - systemctl enable --now devhub-backup.timer devhub-prune.timer
