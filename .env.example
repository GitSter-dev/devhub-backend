DB_HOST=localhost
DB_PORT=5432
DB_NAME=devhub
DB_USER=devhub
DB_PASSWORD=change-me

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=DevHub <no-reply@devhub.local>
PUSH_ENABLED=false
FIREBASE_CREDENTIALS=

# Send metrics and traces to the local Grafana in compose.yaml (http://localhost:3000).
OTEL_EXPORT_ENABLED=true
OTLP_ENDPOINT=http://localhost:4318
# Trace every request locally; production samples 10%.
TRACING_SAMPLING_PROBABILITY=1.0
OTLP_METRICS_STEP=15s
